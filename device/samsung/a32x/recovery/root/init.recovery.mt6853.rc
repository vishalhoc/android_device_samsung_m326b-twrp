# init.recovery.mt6853.rc — Samsung Galaxy M32 5G (SM-M326B)
# Platform: MT6853 (MediaTek Dimensity 720)
# Verified compatible: both A326B and M326B share this MT6853 init sequence
# /dev/block/mmcblk0boot0 confirmed present on M326B (preloader_a)

on init
    setprop sys.usb.configfs 1
    setprop sys.usb.ffs.aio_compat 1

on fs && property:ro.debuggable=0
    # Distinguish USB connection type: CDP vs SDP
    write /sys/class/udc/musb-hdrc/device/cmode 2
    # Set charging free to allow USB activation
    start adbd

on post-fs
    # Support A/B feature for EMMC boot region (preloader_a/b)
    # M326B: preloader_a -> /dev/block/mmcblk0boot0 (verified from block devices)
    wait /dev/block/mmcblk0boot0 2
    symlink /dev/block/sda /dev/block/mmcblk0boot0
